# Sabueso Digital v3 - Central de Alertas Palm Diamante
# Copia este archivo a .env (no lo subas al repositorio) y llena los valores.

# --- Obligatorias -----------------------------------------------------------
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
GRAPH_API_VERSION=v21.0
DESTINATION_PHONES=521XXXXXXXXXX,521YYYYYYYYYY
WEBHOOK_API_KEY=cambia-esto-por-un-secreto-de-24-o-mas-caracteres
REVIEW_SECRET=cambia-esto-por-otro-secreto-de-24-o-mas-caracteres
REVIEW_PIN=cambia-este-pin
PUBLIC_BASE_URL=https://sabueso.palm-diamante.com
# Solo obligatoria en WHATSAPP_MODE=template
FALLBACK_IMAGE_URL=https://palm-diamante.com/logo.png

# --- Opcionales --------------------------------------------------------------
WHATSAPP_MODE=template
TEMPLATE_NAME=alerta_fraude_v3
TEMPLATE_LANG=es_MX
ALLOWED_CAPTURE_HOSTS=
SHEET_WEBHOOK_URL=
SHEET_WEBHOOK_SECRET=
DB_PATH=sabueso_audit.db
