# API Configuration
API_HOST=0.0.0.0
API_PORT=3001
ENVIRONMENT=development
LOG_LEVEL=info

# TensorFlow
TF_CPP_MIN_LOG_LEVEL=2
TF_ENABLE_ONEDNN_OPTS=0

# n8n Configuration
N8N_PASSWORD=your_secure_password_here
N8N_WEBHOOK_URL=http://localhost:5678/

# Instagram API (Meta Graph API)
INSTAGRAM_ACCESS_TOKEN=your_instagram_token_here
INSTAGRAM_ACCOUNT_ID=your_instagram_account_id

# WhatsApp Business API
WHATSAPP_API_KEY=your_whatsapp_api_key
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_RECIPIENT_NUMBER=+52XXXXXXXXXX

# Google Sheets
GOOGLE_SHEETS_API_KEY=your_google_api_key
GOOGLE_SHEETS_REAL_ESTATE_ID=your_sheet_id_here
GOOGLE_SHEETS_SOCIAL_MEDIA_ID=your_sheet_id_here

# Power BI — Arquitectura desacoplada (recomendado)
# repository = solo SQL | streaming = solo Push Dataset | hybrid = ambos
POWERBI_EXPORT_MODE=hybrid
POWERBI_SQL_TABLE=predicciones_tensorflow

# Repositorio central (SQLAlchemy)
# SQLite local (default): sqlite:////absolute/path/predicciones.db
# PostgreSQL: postgresql+psycopg2://user:pass@localhost:5432/tensorflow_bi
# BigQuery: usar conector dedicado / export CSV staged
DATABASE_URL=sqlite:///./backend/data/powerbi/predicciones.db

# Push Dataset (streaming / tiempo real)
# Power BI Service → Nuevo → Conjunto de datos de streaming → API → copiar URL
POWERBI_PUSH_URL=
POWERBI_API_KEY=
POWERBI_WORKSPACE_ID=your_workspace_id
POWERBI_DATASET_ID=your_dataset_id
POWERBI_AUTO_EXPORT_ON_PREDICT=true

# Obsidian Sync
OBSIDIAN_VAULT_PATH=/path/to/your/vault
OBSIDIAN_SYNC_ENABLED=true

# Redis (opcional, para cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Modelo Configuration
MODEL_CACHE_SIZE=100
MODEL_LOAD_ON_STARTUP=true
PREDICTION_TIMEOUT_MS=1000

# Re-training
AUTO_RETRAIN_ENABLED=false
RETRAIN_SCHEDULE_CRON=0 0 1 * *
MIN_SAMPLES_FOR_RETRAIN=50

# Logging
LOG_FILE_PATH=logs/tensorflow-api.log
LOG_ROTATION=daily
LOG_RETENTION_DAYS=30

# Security
API_KEY=your_api_key_here
JWT_SECRET=your_jwt_secret_here
CORS_ORIGINS=*

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090
