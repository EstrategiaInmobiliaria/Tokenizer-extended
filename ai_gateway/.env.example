# Copia este archivo a ai_gateway/.env (o exporta las variables) y rellena las llaves.
# Ninguna es obligatoria: el proveedor sin llave simplemente queda deshabilitado.

# OpenAI (ChatGPT) -> https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Google Gemini -> https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...

# Anthropic Claude -> https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Llave propia del gateway. Los clientes (Cursor, curl, tu app) deben enviarla como
# "Authorization: Bearer <valor>". Déjala vacía para desactivar la autenticación en local.
GATEWAY_API_KEY=cambia-esta-llave

# Modelos por defecto (se usan cuando el cliente pide solo "openai", "gemini" o "claude")
DEFAULT_OPENAI_MODEL=gpt-4o-mini
DEFAULT_GEMINI_MODEL=gemini-2.0-flash
DEFAULT_ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Opcionales
# OPENAI_BASE_URL=https://api.openai.com/v1
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# REQUEST_TIMEOUT=120
# CORS_ORIGINS=*
