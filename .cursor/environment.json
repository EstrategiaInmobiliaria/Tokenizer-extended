{
  "name": "Tokenizer-extended",
  "install": "bash .cursor/install.sh",
  "terminals": [
    {
      "name": "tiktokenizer-web",
      "command": "SKIP_ENV_VALIDATION=1 yarn next dev -p 3000"
    },
    {
      "name": "blueprint-api",
      "command": "cd master_blueprint && /workspace/.venv/bin/uvicorn api.main:app --host 0.0.0.0 --port 8000"
    }
  ],
  "ports": [
    { "name": "tiktokenizer-web", "port": 3000 },
    { "name": "blueprint-api", "port": 8000 }
  ]
}
